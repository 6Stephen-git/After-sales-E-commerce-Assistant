# ============================================================
# 环境变量模板 — 复制为 .env 并填写真实值
# ============================================================

# 多模态 API（Agent 1 图片分析）
VISION_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
VISION_API_KEY=your_api_key_here
# 百炼视觉模型名（与控制台一致；公网 URL 与 data:image/...;base64 均支持）
VISION_API_MODEL=qwen3-vl-flash

# DeepSeek — LLM（Agent 2/3/5，OpenAI 兼容 chat/completions）
# Base URL：https://api.deepseek.com ；完整路径需带 /chat/completions
LLM_API_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_API_KEY=your_api_key_here
# 可选：连接、读响应、连接池等待超时（秒）；读超时过短易出现 read operation timed out
# LLM_HTTP_CONNECT_TIMEOUT=15
# LLM_HTTP_READ_TIMEOUT=120
# LLM_HTTP_POOL_TIMEOUT=15
# 单个 FastAPI/Celery 进程内的 LLM HTTP 连接池上限（不代表跨 worker 的全局限流）
# LLM_HTTP_MAX_CONNECTIONS=20
# LLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
# 单次调用最大尝试次数（含首次）；仅网络异常、429、5xx 会重试
# LLM_HTTP_MAX_ATTEMPTS=3
# 429 优先遵守服务端 Retry-After；其他瞬时失败使用指数退避与随机抖动
# LLM_HTTP_RETRY_BASE_SECONDS=0.5
# LLM_HTTP_RETRY_MAX_SECONDS=8
# 各 Agent 请求体中的 model 字段（与 DeepSeek 控制台模型名一致）
AGENT1_LLM_MODEL=deepseek-v4-flash
AGENT2_LLM_MODEL=deepseek-v4-flash
AGENT2_LLM_MODEL_RULE=deepseek-v4-flash
AGENT2_LLM_MODEL_MALICIOUS=deepseek-v4-flash
AGENT2_LLM_MODEL_STRATEGY=deepseek-v4-pro
AGENT3_LLM_MODEL=deepseek-v4-flash
AGENT4_LLM_MODEL=deepseek-v4-flash
AGENT5_LLM_MODEL=deepseek-v4-flash
JUDGE_LLM_MODEL=deepseek-v4-flash

# 情景 → 测试用例编写 LLM（tests/scenario_gen.py；未设则回落 AGENT2_LLM_MODEL）
# SCENARIO_GEN_LLM_MODEL=deepseek-v4-flash
# SCENARIO_GEN_TEMPERATURE=0.45

# 性能开关：1=启用，0=关闭
# ENABLE_ANALYZE_STREAM=1
# 前端开关（Vite）：启用流式渲染体验
# VITE_ENABLE_ANALYZE_STREAM=1

# 规则匹配索引（Agent1 导航 + match_rules 节内匹配）
RULE_MATCH_LEXICON_PATH=data/rule_match_lexicon.json

# 本地辅助模式占位标识（前端可不传，由 /analyze 自动注入）
DEFAULT_MERCHANT_ID=default
DEFAULT_DISPUTE_ID=local-dispute

# 主数据库（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_assistant
DB_USER=root
DB_PASSWORD=your_password_here

# Redis（Celery 任务队列，db0）
REDIS_URL=redis://localhost:6379/0
# 长耗时分析任务投递语义：late ACK + 单条预取，MySQL Job 是状态事实源
# CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1080
# CELERY_TASK_TIME_LIMIT_SECONDS=1200
# ANALYSIS_JOB_STALE_SECONDS=1800
# 必须大于硬超时与 Job 租约，超时未 ACK 的消息才会被 Redis 重新投递
# CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=2100
# Celery result backend 仅用于运维，不作为前端任务查询来源
# CELERY_RESULT_EXPIRES_SECONDS=3600

# Redis 纠纷缓存（db1，与 Celery 隔离；db0 只做队列）
REDIS_CACHE_URL=redis://localhost:6379/1
ENABLE_REDIS_CACHE=0
AGENT_CACHE_VERSION=1
# Redis 故障后冷却多久再尝试重连（秒）；冷却期内按 cache miss 走主链路
# REDIS_RECONNECT_COOLDOWN_SECONDS=10
# REDIS_CONNECT_TIMEOUT_SECONDS=2

# A/B/C 层固定 TTL（秒）：读命中不续期；key 形如 ea:v2:{layer}:{merchant_hash}:...
MATERIALS_CACHE_TTL_SECONDS=86400
FACTS_CACHE_TTL_SECONDS=86400
REPORT_CACHE_TTL_SECONDS=86400

# V/T 层固定 TTL（秒）
VISION_CACHE_TTL_SECONDS=604800
PROFILE_CACHE_TTL_SECONDS=21600
CASES_CACHE_TTL_SECONDS=21600
# 空判例负缓存：仅缓解穿透，不把“暂时无数据”长期当事实
CASES_EMPTY_CACHE_TTL_SECONDS=60
LOGISTICS_CACHE_TTL_SECONDS=900

# 平台 API（千牛开放平台）
PLATFORM_API_ENDPOINT=https://openapi.taobao.com/router/rest
PLATFORM_APP_KEY=your_app_key_here
PLATFORM_APP_SECRET=your_app_secret_here
