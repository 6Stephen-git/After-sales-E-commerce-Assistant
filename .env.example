# ============================================================
# 环境变量模板 — 复制为 .env 并填写真实值
# ============================================================

# 多模态 API（Agent 1 图片分析）
VISION_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
VISION_API_KEY=your_api_key_here
# 百炼视觉模型名（与控制台一致；公网 URL 与 data:image/...;base64 均支持）
VISION_API_MODEL=qwen3-vl-flash

# 小米 MiMo — LLM（Agent 2/3/5，OpenAI 兼容 chat/completions）
# Token Plan（订阅）：控制台「专属 Base URL」，一般为 token-plan-cn.xiaomimimo.com/v1
# 按量付费：常为 api.xiaomimimo.com/v1；二者与套餐绑定，填错会 402 或计费异常
LLM_API_ENDPOINT=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
LLM_API_KEY=your_api_key_here
# 可选：连接/读响应超时（秒）；读超时过短易出现 read operation timed out
# LLM_HTTP_CONNECT_TIMEOUT=15
# LLM_HTTP_READ_TIMEOUT=120
# 各 Agent 请求体中的 model 字段（与 MiMo 控制台模型名一致）
AGENT1_LLM_MODEL=mimo-v2.5
AGENT2_LLM_MODEL=mimo-v2.5
AGENT2_LLM_MODEL_RULE=mimo-v2.5
AGENT2_LLM_MODEL_MALICIOUS=mimo-v2.5
AGENT2_LLM_MODEL_STRATEGY=mimo-v2.5-pro
AGENT3_LLM_MODEL=mimo-v2.5
AGENT5_LLM_MODEL=mimo-v2.5
JUDGE_LLM_MODEL=mimo-v2.5

# 情景 → 测试用例编写 LLM（tests/scenario_gen.py；未设则回落 AGENT2_LLM_MODEL）
# SCENARIO_GEN_LLM_MODEL=mimo-v2.5
# SCENARIO_GEN_TEMPERATURE=0.45

# 性能开关：1=启用，0=关闭
# ENABLE_ANALYZE_STREAM=1
# 前端开关（Vite）：启用流式渲染体验
# VITE_ENABLE_ANALYZE_STREAM=1

# 规则匹配索引（Agent1 导航 + match_rules 节内匹配）
RULE_MATCH_LEXICON_PATH=data/rule_match_lexicon.json

# 本地辅助模式占位标识（前端可不传，由 /analyze 自动注入）
DEFAULT_MERCHANT_ID=default
DEFAULT_DISPUTE_ID=local-dispute

# 主数据库（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_assistant
DB_USER=root
DB_PASSWORD=your_password_here

# Redis（Celery 任务队列，db0）
REDIS_URL=redis://localhost:6379/0

# Redis 纠纷缓存（db1，与 Celery 隔离）
REDIS_CACHE_URL=redis://localhost:6379/1
ENABLE_REDIS_CACHE=0
AGENT_CACHE_VERSION=1
DISPUTE_CACHE_TTL_SECONDS=86400

# 平台 API（千牛开放平台）
PLATFORM_API_ENDPOINT=https://openapi.taobao.com/router/rest
PLATFORM_APP_KEY=your_app_key_here
PLATFORM_APP_SECRET=your_app_secret_here
