# ============================================================
# 环境变量模板 — 复制为 .env 并填写真实值
# ============================================================

# 多模态 API（Agent 1 图片分析）
VISION_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
VISION_API_KEY=your_api_key_here

# 小米 MiMo — LLM（Agent 2/3/5，OpenAI 兼容 chat/completions）
# 按量付费示例；若使用 Token Plan，以控制台提供的 Base URL + /chat/completions 为准
LLM_API_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
LLM_API_KEY=your_api_key_here
# 各 Agent 请求体中的 model 字段（与 MiMo 控制台模型名一致）
AGENT2_LLM_MODEL=mimo-v2.5-pro
AGENT3_LLM_MODEL=mimo-v2.5
AGENT5_LLM_MODEL=mimo-v2.5

# 规则库路径（Agent 2 match_rules 工具）
RULES_PATH=data/dispute_rules.json

# 话术模板路径（Agent 3 get_script_template 工具）
TEMPLATES_PATH=data/script_templates.json

# 主数据库（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_assistant
DB_USER=root
DB_PASSWORD=your_password_here

# Redis（Celery 任务队列）
REDIS_URL=redis://localhost:6379/0

# 平台 API（千牛开放平台）
PLATFORM_API_ENDPOINT=https://openapi.taobao.com/router/rest
PLATFORM_APP_KEY=your_app_key_here
PLATFORM_APP_SECRET=your_app_secret_here
