{
  "type": "object",
  "required": ["meta", "human_review", "expectation", "taxonomy", "materials", "buyer_profile"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["case_id", "title"],
      "properties": {
        "case_id": { "type": "string" },
        "title": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenario_narrative": { "type": "string" },
    "human_review": {
      "type": "object",
      "required": ["scenario_restated", "fixture_focus", "checks_before_run"],
      "properties": {
        "scenario_restated": { "type": "string" },
        "fixture_focus": { "type": "string" },
        "checks_before_run": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "expectation": {
      "type": "object",
      "properties": {
        "intent_summary": { "type": "string" },
        "acceptable_dispositions": {
          "type": "array",
          "items": { "type": "string", "enum": ["defend", "negotiate", "compensate"] }
        },
        "forbidden_outputs": { "type": "array", "items": { "type": "string" } },
        "expected_report": {
          "type": "object",
          "properties": {
            "malicious_risk_level_in": { "type": "array", "items": { "type": "string" } },
            "malicious_risk_level_min": { "type": "string" },
            "triggered_signal_types_contains": { "type": "array", "items": { "type": "string" } },
            "triggered_signal_types_not_contains": { "type": "array", "items": { "type": "string" } },
            "customer_value_channel": { "type": "string" },
            "customer_value_channel_in": { "type": "array", "items": { "type": "string" } },
            "disposition_in": { "type": "array", "items": { "type": "string" } },
            "disposition_not": { "type": "array", "items": { "type": "string" } },
            "action_type": { "type": "string" },
            "action_type_in": { "type": "array", "items": { "type": "string" } },
            "action_type_not": { "type": "array", "items": { "type": "string" } },
            "strategy_stage_not": { "type": "array", "items": { "type": "string" } },
            "matched_rules_min": { "type": "integer", "minimum": 0 },
            "similar_cases_min": { "type": "integer", "minimum": 0 },
            "actionable_evidence_requests_contains": { "type": "array", "items": { "type": "string" } },
            "actionable_evidence_requests_max": { "type": "integer", "minimum": 0 },
            "reasoning_contains_any": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "primary_axis": {
          "type": "string",
          "enum": ["rule", "malicious", "value", "precedent", "conflict"]
        },
        "evidence_level": { "type": "string", "enum": ["high", "medium", "low"] },
        "buyer_risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "order_amount_band": { "type": "string", "enum": ["low", "medium", "high"] },
        "complexity": { "type": "string", "enum": ["simple", "conflict"] }
      }
    },
    "materials": {
      "type": "object",
      "properties": {
        "order_amount": { "type": "number" },
        "product_category_slug": { "type": "string" },
        "platform_service_tags": { "type": "array", "items": { "type": "string" } },
        "chat_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string", "enum": ["buyer", "merchant"] },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "buyer_profile": { "type": "object" },
    "similar_cases": { "type": "array" },
    "test_overrides": { "type": "object" },
    "evidence_facts": {
      "type": "object",
      "properties": {
        "issue_summary": { "type": "string" },
        "dispute_issue_type": { "type": "string" },
        "defect_type": { "type": "string" },
        "evidence_quality": { "type": "string" },
        "visual_observations": { "type": "array", "items": { "type": "string" } },
        "visual_defect_severity": { "type": "string" },
        "visual_goods_recoverability": { "type": "string" },
        "logistics": {
          "type": "object",
          "properties": {
            "goods_received": { "type": "boolean" },
            "logistics_normal": { "type": "boolean" },
            "time_since_delivery_hours": { "type": "number" },
            "note": { "type": "string" }
          }
        },
        "missing_evidence": { "type": "array", "items": { "type": "string" } },
        "red_flags": { "type": "array", "items": { "type": "string" } },
        "media_present": { "type": "boolean" }
      }
    },
    "facts_override": { "type": "object" },
    "malicious_context": { "type": "object" },
    "steps": { "type": "array" }
  }
}
